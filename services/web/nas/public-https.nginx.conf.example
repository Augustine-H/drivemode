# Reference for an operator-managed Nginx/NPM virtual host.
# Do not overwrite DSM's generated Nginx configuration with this file.
# Replace voice.example.com and certificate paths before use.
server {
    listen 443 ssl;
    server_name voice.example.com;
    ssl_certificate /operator/certificates/fullchain.pem;
    ssl_certificate_key /operator/certificates/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 32m;
    client_body_timeout 120s;

    location / {
        proxy_pass http://127.0.0.1:8097;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        # Public callers must never supply private Serve authentication.
        proxy_set_header Tailscale-User-Login "";
        proxy_set_header Tailscale-User-Name "";
        proxy_set_header Tailscale-User-Profile-Pic "";
        # SSE and TTS use HTTP streaming; no WebSocket is currently needed.
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 130s;
        proxy_send_timeout 130s;
        # Never replay a submitted paid operation on another upstream.
        proxy_next_upstream off;
    }
}
# Optional HTTP redirect ONLY if an operator deliberately enables HTTP/ACME.
# Do not forward another WAN port solely for this application.
# server { listen 80; server_name voice.example.com; return 308 https://voice.example.com$request_uri; }
